# Firebase web app config（皆為公開值，非機密）
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_APP_ID=

# App Check（reCAPTCHA Enterprise）網站金鑰，公開值；留空則不啟用 App Check
VITE_FB_APPCHECK_SITE_KEY=
# 僅本機開發（連正式 Firebase 時）：已在 Firebase Console 登錄的 App Check debug token，勿提交
VITE_FB_APPCHECK_DEBUG_TOKEN=

# 本機開發：設為 true 時連 Firebase Emulator Suite
VITE_USE_EMULATORS=true
